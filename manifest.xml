  <GameVersions>
    <Version>1.0.0</Version>
  </GameVersions>
  <Prerequisites />
  <Assemblies>
    <Assembly>ItemBadges.dll</Assembly>
  </Assemblies>
  <!-- 大多数 mod 为空。用到 files/network/process/steam/steam-auth/window 时才声明；游戏内 F8 运行 mod-scan item_badges 自查 -->
  <Capabilities />
</Manifest>
